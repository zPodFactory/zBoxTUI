/* zBoxTUI - DCUI base styles.
 * Color values come from the active Textual theme (see core/themes.py).
 * - $z-bg / $z-fg            : main content background and its foreground
 * - $z-panel / $z-panel-fg   : header/footer/detail backgrounds and their fg
 * - $z-accent / $z-accent-fg : selection and highlight colors
 */

Screen {
    background: $z-bg;
    scrollbar-background: $z-panel;
    scrollbar-color: $z-scrollbar;
}

ModalScreen {
    background: $z-crust;
}

/* Remove default focus borders Textual adds; widget DEFAULT_CSS draws its own. */
Static:focus, Container:focus, Vertical:focus, Horizontal:focus, Input:focus {
    text-style: none;
    border: none;
}

App, Vertical, Horizontal {
    scrollbar-background: $z-panel;
    scrollbar-color: $z-scrollbar;
}

/* Menu screen - vertical split layout */
#menu-screen {
    layout: vertical;
    width: 100%;
    height: 100%;
}

#menu-header {
    layout: horizontal;
    background: $z-panel;
    color: $z-panel-fg;
    height: 1;
}

#menu-header-left, #menu-header-right {
    width: 1fr;
    padding: 0 1;
}

#menu-body {
    layout: horizontal;
    background: $z-bg;
    color: $z-fg;
    height: 1fr;
}

#menu-list {
    width: 1fr;
    padding: 1 2;
    background: $z-bg;
    color: $z-fg;
}

#menu-detail {
    width: 1fr;
    padding: 1 2;
    background: $z-panel;
    color: $z-panel-fg;
}

#menu-footer {
    layout: horizontal;
    background: $z-panel;
    color: $z-panel-fg;
    height: 1;
}

#menu-footer-left, #menu-footer-right {
    width: 1fr;
    padding: 0 1;
}

#menu-footer-right {
    text-align: right;
}

#menu-footer-center {
    width: 2fr;
    padding: 0 1;
    text-align: center;
}

/* DCUI menu widget */
DCUIMenu {
    background: $z-bg;
    color: $z-fg;
    width: 100%;
    height: auto;
}

DCUIMenu > .menu-item {
    padding: 0 1;
    background: $z-bg;
    color: $z-fg;
}

DCUIMenu > .menu-item.--selected {
    background: $z-accent;
    color: $z-accent-fg;
}

/* Footer key hints */
.key-hint {
    color: $z-fg;
}

.key-name {
    color: $z-accent;
}
