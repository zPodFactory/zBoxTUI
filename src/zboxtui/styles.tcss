/* zBoxTUI - ESXi DCUI Theme */
/* Colors use $z-* CSS variables; concrete values come from theme.py and are */
/* chosen at startup: Catppuccin Mocha (truecolor) or 16-color ANSI (console). */

/* Base app styling */
Screen {
    background: $z-bg;
    scrollbar-background: $z-panel;
    scrollbar-color: $z-scrollbar;
}

/* Modal screens should have black background to dim underlying content */
ModalScreen {
    background: $z-crust;
}

/* Remove default focus styling - but not for dialog sections */
Static:focus {
    text-style: none;
    border: none;
}

Container:focus {
    border: none;
}

Vertical:focus {
    border: none;
}

Horizontal:focus {
    border: none;
}

Input:focus {
    border: none;
}

/* Override default scrollbar colors */
App {
    scrollbar-background: $z-panel;
    scrollbar-color: $z-scrollbar;
}

Vertical {
    scrollbar-background: $z-panel;
    scrollbar-color: $z-scrollbar;
}

Horizontal {
    scrollbar-background: $z-panel;
    scrollbar-color: $z-scrollbar;
}

/* Menu screen - vertical split layout */
#menu-screen {
    layout: vertical;
    width: 100%;
    height: 100%;
}

#menu-header {
    layout: horizontal;
    background: $z-panel;
    color: $z-fg;
    height: 1;
}

#menu-header-left {
    width: 1fr;
    padding: 0 1;
}

#menu-header-right {
    width: 1fr;
    padding: 0 1;
}

#menu-body {
    layout: horizontal;
    background: $z-bg;
    color: $z-fg;
    height: 1fr;
}

#menu-list {
    width: 1fr;
    padding: 1 2;
    background: $z-bg;
    color: $z-fg;
}

#menu-detail {
    width: 1fr;
    padding: 1 2;
    background: $z-panel;
    color: $z-fg;
}

#menu-footer {
    layout: horizontal;
    background: $z-panel;
    color: $z-fg;
    height: 1;
}

#menu-footer-left {
    width: 1fr;
    padding: 0 1;
}

#menu-footer-center {
    width: 2fr;
    padding: 0 1;
    text-align: center;
}

#menu-footer-right {
    width: 1fr;
    padding: 0 1;
    text-align: right;
}

/* DCUI Menu widget */
DCUIMenu {
    background: $z-bg;
    color: $z-fg;
    width: 100%;
    height: auto;
}

DCUIMenu > .menu-item {
    padding: 0 1;
    background: $z-bg;
    color: $z-fg;
}

DCUIMenu > .menu-item.--selected {
    background: $z-accent;
    color: $z-accent-fg;
}

/* Modal dialogs - overlay styling handled in widget DEFAULT_CSS */

/* Footer key hints */
.key-hint {
    color: $z-fg;
}

.key-name {
    color: $z-accent;
}
